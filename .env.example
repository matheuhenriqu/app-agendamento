# Copie para .env / .dev.vars local e preencha com valores reais. Nunca commite chaves reais.
# Supabase (configure os mesmos nomes no Cloudflare Pages > Settings > Variables)
SUPABASE_URL=https://sua-org.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_publishable_ou_anon_key_aqui
# Alias legado aceito pelo backend como fallback:
SUPABASE_ANON_KEY=sua_publishable_ou_anon_key_aqui

# Groq (usada apenas no backend Cloudflare Pages via context.env.GROQ_API_KEY)
GROQ_API_KEY=sua_groq_api_key_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Telegram (opcional — alerta ao dono a cada agendamento confirmado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
