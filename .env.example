# Copie para .env / .dev.vars local e preencha com valores reais. Nunca commite chaves reais.
# Supabase
SUPABASE_URL=https://sua-org.supabase.co
SUPABASE_ANON_KEY=sua_publishable_ou_anon_key_aqui

# Groq (usada apenas no backend Cloudflare Pages via context.env.GROQ_API_KEY)
GROQ_API_KEY=sua_groq_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile
